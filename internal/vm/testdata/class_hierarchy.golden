-- source --
<?php
interface Shape {
    const SIDES = 0;
    public function area(): float;
}
trait Named {
    public function name() { return 'named'; }
    public function hello() { return 'hi'; }
}
trait Greets {
    public function hello() { return 'hello'; }
}
abstract class Base implements Shape {
    use Named, Greets {
        Greets::hello insteadof Named;
        Named::hello as protected namedHello;
        name as label;
    }
    const LIMIT = 10, DOUBLE = self::LIMIT * 2;
    protected static int $count = 0;
    public ?string $tag = null;
    public array $list = [1, 2];
    private readonly int $id;
    public float $ratio = 1 / 3;
    abstract protected function kind(): string;
}
final class Square extends Base {
    public function __construct(private float $side = 1.0) {}
    public function area(): float { return $this->side ** 2; }
    protected function kind(): string { return 'square'; }
}
echo (new Square(2.0))->area(), Square::DOUBLE, Base::class;

