-- source --
<?php
declare(strict_types=1);
function value(int $a, ?string $b = null, int|float ...$rest): int {
    return $a;
}
function none(): void {
    return;
}
function nothing(): void {
}
function stop(): never {
    exit(1);
}
function maybe(?int $x): ?int {
    if ($x) {
        return $x;
    }
    return null;
}
function byRef(array &$a): array {
    return $a;
}
class P {
    public function __construct(public int $x = 0, protected readonly ?string $y = null) {}
    public function get(): static {
        return $this;
    }
}
echo value(1), maybe(2), (new P(1))->get()->x;

