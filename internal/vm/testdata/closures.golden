-- source --
<?php
function f($x) { return $x; }
class K {
    private $p = 1;
    function make() {
        return function ($a) { return $this->p + $a; };
    }
    static function sm() { return static fn() => static::class; }
}
$n = 1;
$m = 2;
$c = function ($a, &$b = null) use ($n,
    &$m) {
    static $calls = 0;
    return $a + $n + $m + ++$calls;
};
$arrow = fn($y) => fn($z) => $y + $z + $n;
$byRef = fn &() => $n + 1;
$g = f(...);
$h = $c(...);
$k = new K;
$i = $k->make(...);
$j = K::sm(...);
$s = 'f';
$t = $s(...);
$arr = [1];
echo $c(1, $arr[0]), $g(2), Closure::bind($c, null)(3), $c->bindTo($k, K::class)(4), $c->call($k, 5);

