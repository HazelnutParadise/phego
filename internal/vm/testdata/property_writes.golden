-- source --
<?php
class C {
    public $p;
    public $a;
    public $arr = [];
    public static $s;
    public static $t = [];
}
$o = new C;
$o->p = 1;
$o->a = new C;
$o->a->p = 2;
$o->arr[1] = 3;
$o->arr[] = 4;
$list = [new C];
$list[0]->p = 5;
C::$s = 6;
C::$t['k'] = 7;
$o->p += 8;
$o->arr[1] .= 'x';
$o->p++;
--$o->a->p;
$o->p ??= 9;
unset($o->p, $o->arr[1]);
echo isset($o->p), isset($o->a->p), empty($o->arr), isset(C::$s), empty(C::$t['k']);
$r = &$o->p;
$x = 10;
$o->p = &$x;
foreach ($o->arr as &$item) {
    $item++;
}

