{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phego capability claims, version 1",
  "description": "Structural checks only; this does not certify support, execution, completeness, or acceptance. Consumers must also validate registry IDs, claim identity, profile, and evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "platform",
        "build"
      ],
      "properties": {
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "status",
        "test_ids",
        "reason"
      ],
      "properties": {
        "kind": {
          "enum": [
            "function",
            "class",
            "constant",
            "extension",
            "ini",
            "sapi"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "supported",
            "unsupported",
            "unverified",
            "policy_denied",
            "semantic_difference",
            "failed"
          ]
        },
        "test_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        },
        "reason": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "supported"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "test_ids": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    }
  }
}
