{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phego execution records (partial)",
  "description": "Structural constraints only. The Phego validator additionally checks registry membership, single commit/profile, paths and file digests. This does not certify execution.",
  "type": "object",
  "required": [
    "records"
  ],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": [
        "release",
        "platform",
        "build"
      ],
      "additionalProperties": false,
      "properties": {
        "release": {
          "type": "string",
          "pattern": "\\S"
        },
        "platform": {
          "type": "string",
          "pattern": "\\S"
        },
        "build": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]+$"
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "test_id",
        "status"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "crash",
            "timeout",
            "unsupported",
            "skip",
            "environment_skip",
            "runner_error",
            "semantic_difference",
            "not_run"
          ]
        },
        "commit": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-f]+$"
        },
        "command": {
          "type": "string",
          "pattern": "\\S"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_run"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "commit"
                  ]
                },
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "profile"
                  ]
                },
                {
                  "required": [
                    "exit_code"
                  ]
                },
                {
                  "required": [
                    "evidence"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "commit",
              "command",
              "profile",
              "exit_code",
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "enum": [
                    "crash",
                    "timeout",
                    "runner_error",
                    "skip",
                    "environment_skip",
                    "unsupported"
                  ]
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "integer"
              }
            }
          }
        }
      ]
    }
  }
}
